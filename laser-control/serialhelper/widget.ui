   <string>QWidget { background-color: #1a1a1a; color: #E0E0E0; }
QPushButton { background-color: #444444; color: #E0E0E0; border: 1px solid #555555; border-radius: 3px; padding: 4px 12px; font-weight: bold; }
QPushButton:hover { background-color: #CC5500; color: white; }
QPushButton:disabled { background-color: #2a2a2a; color: #666666; border-color: #333333; }
QGroupBox { color: #FFFFFF; border: 1px solid #555555; border-radius: 5px; margin-top: 10px; padding-top: 16px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; }
QGroupBox#card1 { border: 1px solid #00C8FF; }
QGroupBox#card2 { border: 1px solid #FFA040; }
QGroupBox#card3 { border: 1px solid #C080FF; }
QGroupBox#card1::title { color: #00C8FF; }
QGroupBox#card2::title { color: #FFA040; }
QGroupBox#card3::title { color: #C080FF; }
QComboBox { background-color: #333333; color: #E0E0E0; border: 1px solid #555555; padding: 2px 6px; }
QSpinBox { background-color: #333333; color: #E0E0E0; border: 1px solid #555555; padding: 2px; }
QPlainTextEdit { background-color: #111111; color: #00CC66; border: 1px solid #555555; }
QLabel { color: #CCCCCC; }
QLabel#bigCurrent1 { color: #00C8FF; font-size: 28px; font-weight: bold; }
QLabel#bigCurrent2 { color: #FFA040; font-size: 28px; font-weight: bold; }
QLabel#bigCurrent3 { color: #C080FF; font-size: 28px; font-weight: bold; }
QLabel#measuredLabel1, QLabel#measuredLabel2, QLabel#measuredLabel3 { color: #FFC840; font-size: 11px; }
QLabel#reasonLabel1, QLabel#reasonLabel2, QLabel#reasonLabel3 { color: #FF6060; font-size: 11px; font-style: italic; }
QLabel#ledLabel1, QLabel#ledLabel2, QLabel#ledLabel3 { font-size: 18px; font-weight: bold; }
QPushButton#tryButton { background-color: #2196F3; }
QPushButton#tryButton:hover { background-color: #CC5500; }</string>
