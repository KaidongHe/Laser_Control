  <property name="styleSheet">
   <string notr="true">QWidget#operatorForm { background: #EEF2F7; }
QFrame#panel {
  background: #ffffff;
  border: 1px solid #DCE3EE;
  border-radius: 10px;
}
QLabel#titleLabel {
  color: #22304f;
  font-family: 'Microsoft YaHei';
  font-size: 22px;
  font-weight: 600;
}
QLabel#subtitleLabel, QLabel#powerLabel {
  color: #7E8794;
  font-family: 'Microsoft YaHei';
  font-size: 15px;
  font-weight: 500;
}
QPushButton#seedButton, QPushButton#preReleaseButton {
  background: #2f6fd6;
  color: white;
  border: none;
  border-radius: 8px;
  font-family: 'Microsoft YaHei';
  font-size: 22px;
  font-weight: 600;
  min-height: 78px;
}
QPushButton#seedButton:hover, QPushButton#preReleaseButton:hover {
  background: #245fbd;
}
QPushButton#seedButton[active='true'], QPushButton#preReleaseButton[active='true'] {
  background: #197A50;
}
QPushButton#seedButton[active='true']:hover, QPushButton#preReleaseButton[active='true']:hover {
  background: #166B46;
}
QPushButton#seedButton:disabled, QPushButton#preReleaseButton:disabled {
  background: #C8D0DC;
  color: #F5F7FA;
}
QPushButton#seedButton[busy='true'], QPushButton#preReleaseButton[busy='true'],
QPushButton#seedButton[busy='true']:disabled, QPushButton#preReleaseButton[busy='true']:disabled {
  background: #D69A1E;
  color: white;
}
QPushButton#developerButton {
  background: transparent;
  color: #9AA4B2;
  border: none;
  padding: 6px 10px;
  font-family: 'Microsoft YaHei';
  font-size: 12px;
}
QPushButton#developerButton:hover {
  color: #5F6B7A;
  background: rgba(47, 111, 214, 0.06);
}
QComboBox#serialComboBox {
  background: #F7F9FC;
  color: #3A4658;
  border: 1px solid #D6DEE9;
  border-radius: 6px;
  padding: 4px 8px;
  font-family: 'Microsoft YaHei';
  font-size: 12px;
}
QComboBox#serialComboBox:disabled {
  color: #8C97A6;
  background: #EDF1F6;
}
QPushButton#serialConnectButton {
  background: #2F6FD6;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 5px 14px;
  font-family: 'Microsoft YaHei';
  font-size: 12px;
  font-weight: 600;
}
QPushButton#serialConnectButton:disabled {
  background: #C8D0DC;
  color: #F5F7FA;
}
QLabel#serialStatusLabel {
  color: #9AA4B2;
  font-family: 'Microsoft YaHei';
  font-size: 12px;
  font-weight: 600;
}
QLabel#temperatureBypassWarningLabel {
  color: #B7791F;
  background: #FFF7DB;
  border: 1px solid #F0C36A;
  border-radius: 6px;
  padding: 5px 8px;
  font-family: 'Microsoft YaHei';
  font-size: 12px;
  font-weight: 600;
}</string>
